        {
          "key": "other_plan_company",
          "label": "Other plan: name of insurance company",
          "control": "select",
          "sets": [
            {
              "placeholder": "- Insurance company -",
              "options": [
                "Beacon",
                "CG",
                "Guardian Life",
                "GTM",
                "Med-Access",
                "NAGICO",
                "Pan-American Life",
                "Sagicor",
                "Surgico"
