        {
          "key": "policy_no",
          "label": "Policy #",
          "control": "text"
        },
        {
          "key": "certificate_no",
          "label": "Certificate #",
          "control": "text"
        },
        {
          "key": "member_id",
          "label": "ID #",
          "control": "text"
        },
        {
          "key": "plan_type",
          "label": "Type of plan",
          "control": "radio",
          "options": [
            [
              "group",
              "Group"
            ],
            [
              "non_group",
              "Non-group"
            ]
          ]
        }
      ]
