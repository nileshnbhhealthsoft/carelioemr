# Dependencies
node_modules/
vendor/

# Environment files (Sensitive Credentials)
.env
.env.backup
.env.production
*.env
!.env.example

# Large archive files & zips (GitHub rejects >100MB)
*.zip
*.tar.gz
*.rar
*.7z
openemr-8.3.0 (1)/

# Build outputs & symlinks
public/build/
public/hot/
public/storage/

# Laravel Storage & Cache
storage/*.key
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

# OpenEMR dynamic tenant site directories (keep baseline)
openemr/sites/site_*
openemr/sites/site-*
public/openemr
public/openemr/

# Logs and Debugging
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.fleet/
.nova/
.zed/
.phpunit.result.cache
.phpunit.cache/
